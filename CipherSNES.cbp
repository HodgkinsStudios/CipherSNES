<?xml version='1.0' encoding='UTF-8'?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6" />
  <Project>
    <Option title="CipherSNES - Core and Linux Frontends" />
    <Option makefile_is_custom="1" />
    <Option pch_mode="2" />
    <Build>
      <Target title="Core Static + Shared">
        <Option output="lib/libCipherSNESCore.a" />
        <Option type="2" />
        <MakeCommands>
          <Build command="make -f Makefile core" />
          <CompileFile command="make -f Makefile core" />
          <Clean command="make -f Makefile clean" />
          <DistClean command="make -f Makefile clean" />
        </MakeCommands>
      </Target>
      <Target title="Debug">
        <Option output="bin/CipherSNES" />
        <Option type="1" />
        <MakeCommands>
          <Build command="make -f Makefile launcher" />
          <CompileFile command="make -f Makefile launcher" />
          <Clean command="make -f Makefile clean" />
          <DistClean command="make -f Makefile clean" />
        </MakeCommands>
      </Target>
      <Target title="Release">
        <Option output="bin/CipherSNES" />
        <Option type="1" />
        <MakeCommands>
          <Build command="make -f Makefile release-launcher" />
          <CompileFile command="make -f Makefile release-launcher" />
          <Clean command="make -f Makefile clean" />
          <DistClean command="make -f Makefile clean" />
        </MakeCommands>
      </Target>
      <Target title="Optimized Core Static + Shared">
        <Option output="lib/libCipherSNESCore.a" />
        <Option type="2" />
        <MakeCommands>
          <Build command="make -f Makefile release-core" />
          <CompileFile command="make -f Makefile release-core" />
          <Clean command="make -f Makefile clean" />
          <DistClean command="make -f Makefile clean" />
        </MakeCommands>
      </Target>
    </Build>
